# Cloudflare Pages 响应头（output:export 下代码里的 headers 不生效，以本文件为准）
# 规则顺序：全局兜底在前，具体路径在后

# geolocation 必须放行同源：首页天气靠浏览器定位权限拿精确坐标（hooks/useWeather.ts）。
# 原先写 geolocation=() 把整条路径掐死在响应头，读者点了同意也拿不到坐标。
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
  Content-Security-Policy: frame-ancestors 'none'

# 构建产物：文件名带内容哈希，永久缓存（回访不再对那批 JS / CSS 发条件请求）
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# 字体：二进制分片永久缓存。fonts.css 现在由 layout.tsx 构建期内联进 <head>，
# 这份文件只是兜底（有人直接访问 /fonts/fonts.css 时给个短缓存，别锁死）
/fonts/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/fonts/fonts.css
  Cache-Control: public, max-age=300

# 分享卡：一周
/og/*
  Cache-Control: public, max-age=604800

# 首屏大图：文件名无哈希但内容极少变，给一周；改图后可手动清缓存
/hero-photo.webp
  Cache-Control: public, max-age=604800

# 搜索索引：一小时（内容随构建更新）
/search-index.json
  Cache-Control: public, max-age=3600

# RSS：十分钟；MIME 也在这里补——静态导出时 route 里设的 headers 不会落盘
/feed.xml
  Cache-Control: public, max-age=600
  Content-Type: application/rss+xml; charset=utf-8
